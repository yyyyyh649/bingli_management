# ============ 云端中转服务器配置（cloud/.env 复制此文件并修改） ============

# 云端监听端口（HTTP，由 nginx/反代终结 HTTPS）
CLOUD_PORT=8080

# 云端数据库文件路径
CLOUD_DB_PATH=./data/cloud.db

# WebSocket 路径（默认 /ws）
CLOUD_WS_PATH=/ws

# 同步鉴权密钥（两端需一致，防止未授权推送；仅限服务器间，非用户鉴权）
SYNC_SECRET=please-change-this-shared-secret

# CORS 允许来源（生产环境建议限定为两店出口 IP 或域名）
CLOUD_CORS_ORIGIN=*
