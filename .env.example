# ============ 店铺本地应用配置（backend/.env 复制此文件并修改） ============

# 店铺标识：store1 / store2（两店分别配置不同值）
STORE_ID=store1

# 本地服务监听端口（两店统一固定为 3000）
PORT=3000

# 数据库文件路径
DB_PATH=./data/local.db

# 删除记录所需密码
DELETE_PASSWORD=safe@safe

# ============ 云端同步配置（Phase 2 启用） ============

# 云端服务器地址（HTTPS 域名，部署后填写实际域名）
CLOUD_SERVER_URL=https://your-cloud-domain.example.com

# 同步轮询间隔（毫秒），默认 5 秒
SYNC_INTERVAL_MS=5000

# 健康检查超时（毫秒）
SYNC_HEALTH_TIMEOUT_MS=3000

# 是否启用同步（true/false）。未配置云端地址时自动降级为离线模式
SYNC_ENABLED=true

# ============ 云端服务器配置（cloud/.env 复制此文件并修改） ============

# 云端监听端口（HTTP，由 nginx/反代终结 HTTPS；或直接 HTTPS 监听 443）
CLOUD_PORT=8080

# 云端数据库文件路径
CLOUD_DB_PATH=./data/cloud.db

# WebSocket 路径（默认 /ws）
CLOUD_WS_PATH=/ws

# 同步鉴权密钥（两端需一致，防止未授权推送；非用户鉴权，仅限服务器间）
SYNC_SECRET=please-change-this-shared-secret

# CORS 允许来源（生产环境建议限定为两店出口 IP 或域名）
CLOUD_CORS_ORIGIN=*
