{
  "name": "optical-shop-system",
  "version": "0.2.0",
  "description": "眼镜店验光单/病例登记系统（本地单店闭环 + 云端同步）",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "cloud"
  ],
  "scripts": {
    "dev:backend": "npm -w backend run dev",
    "dev:frontend": "npm -w frontend run dev",
    "build:frontend": "npm -w frontend run build",
    "start:backend": "npm -w backend start",
    "start:cloud": "npm -w cloud start",
    "init-db": "npm -w backend run init-db",
    "init-cloud-db": "npm -w cloud run init-db"
  },
  "engines": {
    "node": ">=18"
  }
}
